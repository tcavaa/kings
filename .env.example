# ─── Next.js app (Vercel) ───────────────────────────────────────────────────
# Copy to .env.local for local development.

# Supabase Postgres — King Online's tables (profiles, finished games, live
# games, sounds). Supabase → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
# Connections per serverless instance (keep small on Vercel).
DB_POOL_MAX=3

# Score app — the browser talks to Supabase directly with the public anon key.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Where the Socket.IO game server runs (Render). Unset in local dev → the
# page's own host on :3001.
NEXT_PUBLIC_SOCKET_URL=https://kings-game-server.onrender.com

# /admin (sound manager) passcode. Defaults to 2282.
# ADMIN_PASSCODE=

# Championship "calendar day" (daily quota) time zone. Defaults to Asia/Tbilisi.
# APP_TIMEZONE=Asia/Tbilisi
