{
  "name": "kings",
  "private": true,
  "version": "1.0.0",
  "description": "King Online (live card game) + King Score (score keeper) in one Next.js app on one Supabase database.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs && npm --prefix server test",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "db:merge-score-app": "node --env-file-if-exists=.env.local scripts/merge-score-app.mjs",
    "db:optimize-media": "node --env-file-if-exists=.env.local scripts/optimize-media.mjs",
    "db:unembed-game-photos": "node --env-file-if-exists=.env.local scripts/unembed-game-photos.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "canvas-confetti": "1.9.4",
    "lucide-react": "1.25.0",
    "next": "16.4.0",
    "phaser": "3.90.0",
    "postgres": "3.4.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.8.1",
    "socket.io-client": "4.8.3"
  },
  "devDependencies": {
    "autoprefixer": "10.5.0",
    "postcss": "8.5.12",
    "tailwindcss": "3.4.19"
  }
}
