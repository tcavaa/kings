# ─── Required: Supabase Postgres ────────────────────────────────────────────
# Profiles, finished games, live-game snapshots and sounds live in the shared
# Supabase database (KINGS). Without it the game still runs, but nothing
# is saved. Supabase → Connect → "Transaction pooler" URI (port 6543), the
# same value the Vercel app uses.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# ─── Server ─────────────────────────────────────────────────────────────────
# HTTP + WebSocket port (Render sets this for you).
PORT=3001

# Comma-separated list of allowed origins (Socket.IO CORS) — the Next.js
# app's URL(s) in production, e.g. https://kings.vercel.app
# Use "*" only for local development.
CORS_ORIGIN=*

# Wall-clock zone of the championship "calendar day" (2/8 games a day).
APP_TIMEZONE=Asia/Tbilisi
